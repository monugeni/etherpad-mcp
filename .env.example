# Required: URL of your Etherpad instance
ETHERPAD_URL=http://192.168.1.50:9001

# Required: API key from Etherpad's APIKEY.txt file
ETHERPAD_API_KEY=your-api-key-here

# Optional: HTTP server port (default: 3100)
PORT=8209

# Optional: HTTP server bind address (default: 0.0.0.0)
HOST=0.0.0.0

# Optional: Bearer token to protect the MCP server (recommended for LAN)
MCP_API_KEY=

# Optional: Transport mode - "http" or "stdio" (default: http)
TRANSPORT=http
